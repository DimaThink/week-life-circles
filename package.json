{
  "name": "week-life-circles",
  "version": "1.0.6",
  "description": "Life-in-weeks grid journal: one colored circle per week or day of your life, each linked to a note.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "TZ=UTC vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "obsidian": "^1.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
